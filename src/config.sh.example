# config.sh — настройки ServerControl под ваш сервер.
# Скопируйте этот файл рядом с server_api.sh и отредактируйте.
# Все переменные необязательные — незаполненные работают по умолчанию.

# --- Диск с данными (модели, бэкапы, результаты) ---
# Если есть, в интерфейсе появится второй диск. Пример: /mnt/hdd
DATA_DISK=""

# --- Службы, которые нужно отслеживать ---
# Пишите имена юнитов через пробел. В интерфейсе они появятся с индикаторами.
# Примеры: nginx docker smbd postgresql redis
WATCH_SERVICES=""

# --- Каталог для логов здоровья (создастся установщиком) ---
HEALTH_DIR="/var/log/servercontrol"

# --- Маркеры запущенных процессов (поиск через pgrep -f) ---
# Генерация изображений/видео — если у вас такое есть
GENERATION_MARKER=""
# Ваш AI-агент или другой процесс
AGENT_MARKER=""

# --- Лог бэкапа ---
BACKUP_LOG=""

# --- Команды кнопок в приложении ---
# Если пусто — кнопка не показывается.
BACKUP_COMMAND=""          # например: /usr/local/bin/backup.sh
AGENT_START_COMMAND=""     # например: screen -dmS agent /opt/agent/start.sh
AGENT_STOP_COMMAND=""      # например: screen -S agent -X quit

# --- Порт для туннеля AI-агента (если используете) ---
AGENT_PORT=""

# --- Полезные ссылки, которые откроются в браузере ---
# Формат: "Название|http://адрес:порт" через точку с запятой
# Пример: LINKS="Grafana|http://127.0.0.1:3000;Nextcloud|http://127.0.0.1:8080"
LINKS=""
